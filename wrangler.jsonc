{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "franzmann-bad-heizung-weinheim",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
