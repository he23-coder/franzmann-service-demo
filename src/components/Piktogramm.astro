---
/**
 * Eigene Piktogramme im Duktus einer Haustechnik-Zeichnung:
 * gleiche Strichstärke, 24er-Raster, keine Flächen. Bewusst keine
 * Icon-Bibliothek — die Symbole zeigen die Geräte dieses Gewerks.
 */
import type { PictogramName } from '@/data/services';

interface Props {
  name: PictogramName;
  size?: number;
  class?: string;
}
const { name, size = 28, class: klasse } = Astro.props;

const pfade: Record<PictogramName, string> = {
  // Wärmepumpe: Außeneinheit mit Ventilator und Luftstrom
