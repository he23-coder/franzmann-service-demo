  // Brennwertkessel: Wandgerät mit Flamme und Anschlüssen
  brennwert: `<rect x="4.5" y="3.5" width="15" height="13" rx="1.2"/><path d="M12 7.2c1.6 1.5 2.4 2.8 2.4 4a2.4 2.4 0 0 1-4.8 0c0-.8.3-1.5.9-2.2.3.7.7 1.1 1.1 1.3-.1-1.1.1-2.1.4-3.1Z"/><path d="M8 16.5v4M16 16.5v4M12 16.5v2.5"/>`,
  // Pelletkessel: Kessel mit Brennstoffzufuhr und Flamme
  pellet: `<rect x="3.5" y="7.5" width="12" height="12" rx="1.2"/><path d="M9.5 11.4c1.2 1.1 1.8 2 1.8 2.9a1.8 1.8 0 0 1-3.6 0c0-.6.2-1.1.7-1.6.2.5.5.8.8 1-.1-.8 0-1.6.3-2.3Z"/><circle cx="19" cy="5.5" r="1.4"/><circle cx="19" cy="9.6" r="1.4"/><path d="M17.6 7.5h-2.1"/>`,
  // Solarthermie: Kollektor mit Sonne
  solarthermie: `<rect x="2.5" y="12" width="14" height="8.5" rx="1" transform="skewX(-8)"/><path d="M6 12v8.5M10.5 12v8.5"/><circle cx="18" cy="5.5" r="2.6"/><path d="M18 1.4v1.2M18 8.4v1.2M21.9 5.5h-1.2M15.3 5.5h-1.2M20.8 2.7l-.9.9M16.1 7.4l-.9.9"/>`,
  // Blockheizkraftwerk: Modul mit Wärme- und Stromabgang
  bhkw: `<rect x="2.5" y="6.5" width="14" height="11" rx="1.2"/><circle cx="7.5" cy="12" r="2.2"/><path d="M11.5 9.6h3M11.5 12h3M11.5 14.4h3"/><path d="M19.5 8.5l-2.2 4h2.4l-2.2 4"/>`,
  // Brennstoffzelle: Zellenstapel
  brennstoffzelle: `<rect x="4.5" y="4.5" width="15" height="15" rx="1.2"/><path d="M4.5 9h15M4.5 12h15M4.5 15h15"/><path d="M9 1.5v3M15 1.5v3M9 19.5v3M15 19.5v3"/>`,
  // Badewanne
  badewanne: `<path d="M2.5 12.5h19v2.2a4 4 0 0 1-4 4H6.5a4 4 0 0 1-4-4v-2.2Z"/><path d="M6 12.5V6.2a2.2 2.2 0 0 1 4.4 0"/><path d="M8.6 6.6h3.2"/><path d="M6.5 18.7l-1 2.8M17.5 18.7l1 2.8"/>`,
  // Dusche: Brausekopf mit Tropfen
  dusche: `<path d="M12 2.5v4.2"/><path d="M6.5 10.5a5.5 5.5 0 0 1 11 0Z"/><path d="M8.6 14.2v1.6M12 14.9v1.9M15.4 14.2v1.6M10.2 18.4v1.5M13.8 18.4v1.5"/>`,
  // Barrierefreies Bad: Haltegriff und Sitz
  barrierefrei: `<path d="M3.5 4.5v15"/><path d="M3.5 9.5h9a2.2 2.2 0 0 1 0 4.4h-9"/><rect x="14.5" y="12" width="6" height="2.4" rx="1.2"/><path d="M17.5 14.4v5.1"/><path d="M6.5 19.5h11"/>`,
  // Gäste-WC
  'gaeste-wc': `<path d="M6 3.5h4.5v5.5"/><path d="M4.5 9h11v2.6a5.5 5.5 0 0 1-5.5 5.5A5.5 5.5 0 0 1 4.5 11.6V9Z"/><path d="M10 17.1v3.4h6"/><path d="M17.5 4.5h3v7h-3z"/>`,
  // 3D-Planung: Raum als Achskreuz
  'planung-3d': `<path d="M4 20V8.5l8-5 8 5V20"/><path d="M4 8.5l8 5 8-5M12 13.5V20"/><path d="M2 20h20"/>`,
  // Split-Klimagerät mit Luftstrom
  klimasplit: `<rect x="2.5" y="5" width="19" height="6.5" rx="1.6"/><path d="M5.5 8.2h13"/><path d="M7 14.5c1.4.8 1.4 1.9 0 2.7s-1.4 1.9 0 2.7"/><path d="M12 14.5c1.4.8 1.4 1.9 0 2.7s-1.4 1.9 0 2.7"/><path d="M17 14.5c1.4.8 1.4 1.9 0 2.7s-1.4 1.9 0 2.7"/>`,
  // Lüftung: Umluft
  lueftung: `<circle cx="12" cy="12" r="8.5"/><path d="M12 3.5c2.5 2.5 2.5 5.5 0 8.5s-2.5 6 0 8.5"/><path d="M3.5 12c2.5-2.5 5.5-2.5 8.5 0s6 2.5 8.5 0"/>`,
  // Wartung: Schraubenschlüssel am Zahnrad
  // Wartung: Schraubenschlüssel und Schraubendreher gekreuzt
  wartung: `<path d="M14.4 3.1a4.2 4.2 0 0 0-5.3 5.3l-6.2 6.2a1.6 1.6 0 0 0 0 2.3l1.4 1.4a1.6 1.6 0 0 0 2.3 0l6.2-6.2a4.2 4.2 0 0 0 5.3-5.3l-2.6 2.6-2.5-.5-.5-2.5 2.6-2.6Z"/><path d="M4.6 4.3 3.2 5.7a1.4 1.4 0 0 0 0 2l7.7 7.7"/><path d="m15.6 14.4 4.4 4.4a1.7 1.7 0 0 1-2.4 2.4l-4.4-4.4"/>`,
  // Reparatur: Schraubenschlüssel
  reparatur: `<path d="M15.6 3.4a5 5 0 0 0-6.3 6.3L3 16v4.5h4.5l6.3-6.3a5 5 0 0 0 6.3-6.3l-3 3-3-.6-.6-3 3-3Z"/>`,
  // Notdienst: Warnsignal
  notdienst: `<path d="M12 3.2 21.4 19a1.1 1.1 0 0 1-1 1.6H3.6a1.1 1.1 0 0 1-1-1.6L12 3.2Z"/><path d="M12 9.5v4.4"/><circle cx="12" cy="17" r=".9" fill="currentColor" stroke="none"/>`,
  // Telefon
  telefon: `<path d="M6.6 2.8h3.2l1.6 4.3-2.2 1.6a12.8 12.8 0 0 0 6.1 6.1l1.6-2.2 4.3 1.6v3.2a2.2 2.2 0 0 1-2.4 2.2A18.2 18.2 0 0 1 4.4 5.2 2.2 2.2 0 0 1 6.6 2.8Z"/>`,
  // E-Mail
  mail: `<rect x="2.5" y="4.8" width="19" height="14.4" rx="2"/><path d="m3.2 6.2 8.8 5.9 8.8-5.9"/>`,
  // Terminanfrage: Kalenderblatt mit Haken
  termin: `<rect x="3.2" y="4.8" width="17.6" height="16" rx="2"/><path d="M3.2 9.4h17.6M8 2.8v4M16 2.8v4"/><path d="m9 14.6 2.1 2.1 4-4"/>`,
  // Beratung: Gespräch am Plan
  beratung: `<path d="M3.5 5.5h12v8h-6l-3.5 3v-3h-2.5v-8Z"/><path d="M18 9.5h2.5v8H18l-2.5 3v-3"/><path d="M6.5 8.5h6M6.5 11h3.5"/>`,
};

const d = pfade[name] ?? pfade.beratung;
---

<svg
  class:list={['piktogramm', klasse]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={d}
/>

<style>
  .piktogramm {
    flex: none;
    vector-effect: non-scaling-stroke;
  }
</style>
