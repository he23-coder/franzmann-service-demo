---
/**
 * Feste Navigation.
 *
 * Auf dem Telefon zweizeilig wie ein Schriftfeld im Plan: oben die Marke und
 * die dringendste Handlung, darunter die Leistungen als scrollbare Reiter.
 * Kein Burger-Menü — alle Ziele bleiben sichtbar und mit dem Daumen erreichbar.
 */
import { business } from '@/data/business';
import { services } from '@/data/services';

const { pathname } = Astro.url;
const aktiv = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);

const reiter = [
  ...services.map((s) => ({ href: `/leistungen/${s.slug}`, label: s.navLabel })),
  { href: '/team', label: 'Betrieb' },
  { href: '/kontakt', label: 'Kontakt' },
];
---

<header class="kopf">
  <div class="kopf__zeile">
    <a class="marke" href="/" aria-label={`${business.legalName} — Startseite`}>
      <img src="/franzmann-logo.png" alt="" width="286" height="156" class="marke__bild" />
      <span class="nur-sr">{business.brand} {business.brandLine}</span>
    </a>

    <nav class="kopf__weit" aria-label="Hauptnavigation">
      <ul>
        {reiter.map((r) => (
          <li>
            <a href={r.href} class:list={['kopf__link', aktiv(r.href) && 'ist-hier']}
               aria-current={aktiv(r.href) ? 'page' : undefined}>{r.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="kopf__handlungen">
      <a class="kopf__ruf" href={business.phone.href}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6.5 3.5h3l1.5 4-2 1.5a12 12 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.5 5.7a2 2 0 0 1 2-2.2Z"/>
        </svg>
        <span class="kopf__ruf-text">{business.phone.display}</span>
        <span class="nur-sr">anrufen</span>
      </a>
      <a class="knopf knopf--handlung kopf__termin" href="/termin">Termin anfragen</a>
    </div>
  </div>

  <nav class="kopf__reiter" aria-label="Bereiche">
    <ul>
      {reiter.map((r) => (
        <li>
          <a href={r.href} class:list={['reiter', aktiv(r.href) && 'ist-hier']}
             aria-current={aktiv(r.href) ? 'page' : undefined}>{r.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .kopf {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--papier) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--linie);
  }

  .kopf__zeile {
    width: var(--schacht);
    margin-inline: auto;
    height: 3.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .marke { display: flex; align-items: center; flex: none; }
  .marke__bild {
    width: auto;
    height: 1.55rem;
    /* Die Wortmarke bleibt unverändert; nur die Größe wird angepasst. */
  }

  /* --- Reiterzeile (Telefon) --- */
  .kopf__reiter {
    border-top: 1px solid var(--linie);
    background: color-mix(in srgb, var(--papier-2) 70%, transparent);
  }
  .kopf__reiter ul {
    display: flex;
    gap: .25rem;
    list-style: none;
    margin: 0;
    padding: 0 var(--spur);
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity;
  }
  .kopf__reiter ul::-webkit-scrollbar { display: none; }

  .reiter {
    display: flex;
    align-items: center;
    height: 2.75rem;
    padding-inline: .7rem;
    white-space: nowrap;
    scroll-snap-align: start;
    font-family: var(--f-mono);
    font-size: .75rem;
    letter-spacing: .07em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: color var(--t-kurz) var(--e-aus), border-color var(--t-kurz) var(--e-aus);
  }
  .reiter:hover { color: var(--navy); }
  .reiter.ist-hier { color: var(--navy); border-bottom-color: var(--azure); }

  /* --- Handlungen --- */
  .kopf__handlungen { margin-left: auto; display: flex; align-items: center; gap: .5rem; }

  .kopf__ruf {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding-inline: .6rem;
    border: 1px solid var(--linie-stark);
    border-radius: var(--r-2);
    color: var(--navy);
    text-decoration: none;
    font-weight: 600;
    font-size: .9375rem;
    transition: background var(--t-kurz) var(--e-aus), border-color var(--t-kurz) var(--e-aus);
  }
  .kopf__ruf:hover { background: var(--papier-2); border-color: var(--navy); color: var(--navy); }
  .kopf__ruf-text { display: none; }

  .kopf__termin { min-height: 2.75rem; padding: .55rem 1rem; font-size: .9375rem; }
  .kopf__weit { display: none; }

  /* --- Ab Tablet: eine Zeile, volle Navigation --- */
  @media (min-width: 60rem) {
    .kopf__zeile { height: 4.75rem; gap: 2rem; }
    .marke__bild { height: 2rem; }
    .kopf__reiter { display: none; }
    .kopf__weit { display: block; }
    .kopf__weit ul {
      display: flex;
      gap: .35rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .kopf__link {
      display: flex;
      align-items: center;
      height: 2.5rem;
      padding-inline: .8rem;
      border-radius: var(--r-2);
      font-size: .9375rem;
      font-weight: 600;
      color: var(--ink-2);
      text-decoration: none;
      transition: background var(--t-kurz) var(--e-aus), color var(--t-kurz) var(--e-aus);
    }
    .kopf__link:hover { background: var(--papier-2); color: var(--navy); }
    .kopf__link.ist-hier { color: var(--navy); background: var(--papier-3); }
    .kopf__ruf-text { display: inline; }
  }

  /* Querformat auf dem Telefon: Zeilen niedriger halten */
  @media (max-height: 30rem) and (max-width: 60rem) {
    .kopf__zeile { height: 3rem; }
    .reiter { height: 2.4rem; }
  }
</style>
