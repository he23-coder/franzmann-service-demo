---
/**
 * Der Gebäudeschnitt.
 *
 * Grundgedanke: Der Betrieb beschreibt seine Arbeit selbst mit dem Satz
 * „Wir decken das gesamte Spektrum von Keller bis zum Dach ab."
 * Genau das ist hier gezeichnet — als Schnitt durch ein Haus, so wie ihn
 * jede Haustechnik-Planung verwendet. Jede Ebene führt zu der Leistung,
 * die dort tatsächlich sitzt: Wärmeerzeugung in den Keller, das Bad ins
 * Wohngeschoss, Klima und Solar aufs Dach, der Kundendienst an den
 * Steigstrang, der durch alle Ebenen läuft.
 *
 * Geschnittene Wände sind schraffiert, wie in einer echten Zeichnung.
 */
import Piktogramm from './Piktogramm.astro';
import { services } from '@/data/services';

interface Props {
  /** „blatt" löst das eigene Raster auf: Kopf, Zeichnung und Legende
      ordnet dann die Seite selbst an. */
  anordnung?: 'nebeneinander' | 'blatt';
}
const { anordnung = 'nebeneinander' } = Astro.props;

const waerme = services.find((s) => s.slug === 'waerme')!;
const bad = services.find((s) => s.slug === 'bad')!;
const klima = services.find((s) => s.slug === 'klima')!;
const dienst = services.find((s) => s.slug === 'kundendienst')!;
---

<div class:list={['schnitt', anordnung === 'blatt' && 'schnitt--blatt']} data-haus-schnitt>
  <figure class="schnitt__zeichnung">
    <svg viewBox="0 0 560 660" role="img"
         aria-labelledby="schnitt-titel schnitt-text" class="schnitt__svg">
      <title id="schnitt-titel">Schnitt durch ein Wohnhaus</title>
      <desc id="schnitt-text">
        Ein Wohnhaus im Schnitt mit vier Bereichen: Dach mit Solarkollektor und
        Klimagerät, Wohngeschoss mit Bad, Keller mit Wärmeerzeuger und dem
        Steigstrang, der alle Ebenen verbindet. Jeder Bereich führt zur
        zugehörigen Leistung.
      </desc>

      <defs>
        <pattern id="mauer" width="8" height="8" patternTransform="rotate(45)"
                 patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="8" stroke="var(--navy)" stroke-width="1" opacity=".38"/>
        </pattern>
        <pattern id="erde" width="12" height="12" patternTransform="rotate(45)"
                 patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="12" stroke="var(--sandstein-tief)" stroke-width="1" opacity=".3"/>
        </pattern>
        <clipPath id="dachfeld">
          <polygon points="280,96 456,218 104,218"/>
        </clipPath>
      </defs>

      <!-- Erdreich -->
      <g class="erdreich">
        <rect x="0" y="440" width="560" height="220" fill="url(#erde)"/>
        <line x1="0" y1="440" x2="560" y2="440" class="linie-stark"/>
      </g>

      <!-- Baukörper: Wände geschnitten, daher schraffiert -->
      <g class="bau">
        <polygon points="280,88 468,218 452,218 280,108 108,218 92,218"
                 fill="url(#mauer)" class="linie"/>
        <rect x="108" y="218" width="16" height="354" fill="url(#mauer)" class="linie"/>
        <rect x="436" y="218" width="16" height="354" fill="url(#mauer)" class="linie"/>
        <rect x="108" y="300" width="344" height="14" fill="url(#mauer)" class="linie"/>
        <rect x="108" y="426" width="344" height="14" fill="url(#mauer)" class="linie"/>
        <rect x="108" y="558" width="344" height="14" fill="url(#mauer)" class="linie"/>
      </g>

      <!-- Solarkollektor auf der linken Dachfläche -->
      <g class="einbau" clip-path="url(#dachfeld)">
        <polygon points="168,196 262,130 286,148 192,214" class="flaeche-luft linie"/>
        <line x1="192" y1="180" x2="270" y2="146" class="linie-fein"/>
        <line x1="206" y1="196" x2="284" y2="162" class="linie-fein"/>
      </g>

      <!-- Steigstrang: Vorlauf warm, Rücklauf kühl -->
      <g class="strang" aria-hidden="true">
        <path class="strang__rohr strang__rohr--vor"
              d="M382 548 L382 236"/>
        <path class="strang__rohr strang__rohr--rueck"
              d="M400 236 L400 548"/>
        <path class="strang__fluss strang__fluss--vor" d="M382 548 L382 236"/>
        <path class="strang__fluss strang__fluss--rueck" d="M400 236 L400 548"/>
        <!-- Abgänge zu den Ebenen -->
        <path class="strang__abgang" d="M382 356 L318 356 M400 386 L318 386"/>
        <path class="strang__abgang" d="M382 262 L336 262"/>
      </g>

      <!-- Wärmeerzeuger im Keller -->
      <g class="einbau">
        <rect x="150" y="470" width="86" height="88" rx="3" class="flaeche-waerme linie"/>
        <path d="M193 500c9 9 13 16 13 22a13 13 0 0 1-26 0c0-5 2-9 6-13 1 4 3 6 5 7-1-6 0-11 2-16Z"
              class="linie-flamme"/>
        <line x1="236" y1="512" x2="382" y2="512" class="linie"/>
        <rect x="262" y="470" width="54" height="60" rx="3" class="linie-fein flaeche-hell"/>
        <text x="289" y="504" class="beschriftung-klein">PUFFER</text>
      </g>

      <!-- Bad im Wohngeschoss -->
      <g class="einbau">
        <path d="M170 380h84v18a16 16 0 0 1-16 16h-52a16 16 0 0 1-16-16v-18Z" class="flaeche-wasser linie"/>
        <path d="M184 380v-24a9 9 0 0 1 18 0" class="linie"/>
        <rect x="272" y="368" width="30" height="46" rx="2" class="linie-fein flaeche-hell"/>
      </g>

      <!-- Klimagerät im Dachgeschoss -->
      <g class="einbau">
        <rect x="176" y="238" width="76" height="24" rx="4" class="flaeche-luft linie"/>
        <line x1="188" y1="252" x2="240" y2="252" class="linie-fein"/>
        <path d="M196 274c6 4 6 8 0 12M214 274c6 4 6 8 0 12M232 274c6 4 6 8 0 12"
              class="linie-fein"/>
      </g>

      <!-- Wärmepumpe außen -->
      <g class="einbau">
        <rect x="474" y="382" width="66" height="56" rx="3" class="flaeche-waerme linie"/>
        <circle cx="507" cy="410" r="15" class="linie-fein"/>
        <path d="M507 395v30M492 410h30" class="linie-fein"/>
        <line x1="474" y1="410" x2="452" y2="410" class="linie"/>
      </g>

      <!-- Maßlinien links, wie in einer Zeichnung -->
      <g class="masskette" aria-hidden="true">
        <line x1="62" y1="218" x2="62" y2="572"/>
        <g class="masskette__tick">
          <line x1="55" y1="218" x2="69" y2="218"/>
          <line x1="55" y1="307" x2="69" y2="307"/>
          <line x1="55" y1="433" x2="69" y2="433"/>
          <line x1="55" y1="572" x2="69" y2="572"/>
        </g>
      </g>

      <!-- Interaktive Ebenen. Reihenfolge = Tab-Reihenfolge von oben nach unten. -->
      <a class="zone" data-zone="klima" href={`/leistungen/${klima.slug}`}
         aria-label={`${klima.name} — ${klima.teaser}`}>
        <polygon class="zone__feld" points="280,108 452,218 452,300 108,300 108,218"/>
        <rect class="zone__ziel" x="108" y="108" width="344" height="192" fill="transparent"/>
        <text class="zone__marke" x="128" y="290">DACH</text>
      </a>

      <a class="zone" data-zone="bad" href={`/leistungen/${bad.slug}`}
         aria-label={`${bad.name} — ${bad.teaser}`}>
        <rect class="zone__feld" x="124" y="314" width="312" height="112"/>
        <rect class="zone__ziel" x="124" y="314" width="312" height="112" fill="transparent"/>
        <text class="zone__marke" x="140" y="416">WOHNEN</text>
      </a>

      <a class="zone" data-zone="waerme" href={`/leistungen/${waerme.slug}`}
         aria-label={`${waerme.name} — ${waerme.teaser}`}>
        <rect class="zone__feld" x="124" y="440" width="312" height="118"/>
        <rect class="zone__ziel" x="124" y="440" width="312" height="118" fill="transparent"/>
        <text class="zone__marke" x="140" y="550">KELLER</text>
      </a>

      <a class="zone zone--strang" data-zone="kundendienst" href={`/leistungen/${dienst.slug}`}
         aria-label={`${dienst.name} — ${dienst.teaser}`}>
        <rect class="zone__feld" x="370" y="230" width="42" height="326" rx="3"/>
        <rect class="zone__ziel" x="366" y="230" width="50" height="326" fill="transparent"/>
      </a>
    </svg>
    <!-- Schriftfeld, wie es jede Zeichnung unten trägt -->
    <figcaption class="blattmarke">
      <span>Schnitt durch ein Wohnhaus</span>
      <span aria-hidden="true">Wärme · Wasser · Luft</span>
      <span aria-hidden="true">Weinheim · Bergstraße</span>
    </figcaption>
  </figure>

  <!-- Begleitende Liste: gleiche Ziele, ohne Zeichnung bedienbar. -->
  <ul class="schnitt__legende">
    {[klima, bad, waerme, dienst].map((s) => (
      <li>
        <a class="legende" href={`/leistungen/${s.slug}`} data-legende={s.slug}
           data-medium={s.medium}>
          <span class="legende__zeichen"><Piktogramm name={s.pictogram} size={22} /></span>
          <span class="legende__text">
            <strong>{s.name}</strong>
            <span class="mass">{s.ebene === 'dach' ? 'Dach' : s.ebene === 'wohnen' ? 'Wohngeschoss' : s.ebene === 'keller' ? 'Keller' : 'Steigstrang'}</span>
            <small>{s.teaser}</small>
          </span>
          <svg class="legende__pfeil" width="18" height="18" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .schnitt {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  /* Auf dem Planblatt bestimmt die Seite die Anordnung. */
  @media (min-width: 62rem) {
    .schnitt--blatt { display: contents; }
  }

  @media (min-width: 62rem) {
    .schnitt {
      grid-template-columns: minmax(0, 1fr) 21.5rem;
      align-items: center;
      gap: 2.25rem;
    }
  }

  .schnitt__zeichnung {
    margin: 0;
    padding: clamp(.75rem, 2vw, 1.25rem);
    background: var(--weiss);
    border: 1px solid var(--linie-stark);
    border-radius: var(--r-2);
    /* Doppellinie wie der Rand eines Zeichnungsblattes */
    box-shadow: inset 0 0 0 1px var(--weiss), inset 0 0 0 2px var(--linie);
  }

  .blattmarke {
    display: flex;
    flex-wrap: wrap;
    gap: .3rem 1.25rem;
    margin-top: .75rem;
    padding-top: .7rem;
    border-top: 1px solid var(--linie);
    font-family: var(--f-mono);
    font-size: .625rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .blattmarke span:first-child { color: var(--navy); font-weight: 500; }

  .schnitt__svg {
    width: 100%;
    height: auto;
    max-height: min(64vh, 34rem);
    margin-inline: auto;
    overflow: visible;
  }

  /* --- Strichstärken wie im Plan --- */
  .linie { stroke: var(--navy); stroke-width: 1.6; fill: none; }
  .linie-stark { stroke: var(--sandstein-tief); stroke-width: 2; }
  .linie-fein { stroke: var(--navy); stroke-width: 1; fill: none; opacity: .65; }
  .linie-flamme { stroke: var(--medium-waerme); stroke-width: 1.6; fill: none; }

  .bau polygon, .bau rect { stroke: var(--navy); stroke-width: 1.4; }
  .erdreich rect { opacity: .5; }

  .flaeche-hell { fill: var(--weiss); }
  .flaeche-waerme { fill: var(--medium-waerme-flaeche); }
  .flaeche-wasser { fill: var(--medium-wasser-flaeche); }
  .flaeche-luft { fill: var(--medium-luft-flaeche); }

  .beschriftung-klein {
    font-family: var(--f-mono);
    font-size: 9px;
    letter-spacing: .1em;
    fill: var(--ink-3);
    text-anchor: middle;
  }

  .masskette line { stroke: var(--linie-stark); stroke-width: 1; }
  .masskette__tick line { stroke: var(--sandstein-tief); }

  /* --- Steigstrang: Vorlauf und Rücklauf --- */
  .strang__rohr { stroke-width: 3; fill: none; opacity: .28; }
  .strang__rohr--vor { stroke: var(--medium-waerme); }
  .strang__rohr--rueck { stroke: var(--medium-wasser); }
  .strang__abgang { stroke: var(--navy); stroke-width: 1.2; opacity: .4; fill: none; }

  .strang__fluss {
    fill: none;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 16 190;
  }
  .strang__fluss--vor {
    stroke: var(--medium-waerme);
    animation: fliessen-auf 5.5s linear infinite;
  }
  .strang__fluss--rueck {
    stroke: var(--medium-wasser);
    animation: fliessen-ab 5.5s linear infinite;
    animation-delay: -2.75s;
  }
  @keyframes fliessen-auf  { from { stroke-dashoffset: 0; } to { stroke-dashoffset: -206; } }
  @keyframes fliessen-ab   { from { stroke-dashoffset: 0; } to { stroke-dashoffset: -206; } }

  /* --- Interaktive Ebenen --- */
  .zone { cursor: pointer; }
  .zone__feld {
    fill: transparent;
    stroke: transparent;
    stroke-width: 1.5;
    transition: fill var(--t-mittel) var(--e-aus), stroke var(--t-mittel) var(--e-aus);
  }
  .zone__marke {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: .16em;
    fill: var(--ink-3);
    transition: fill var(--t-mittel) var(--e-aus);
  }

  .zone[data-zone='klima']:hover .zone__feld,
  .zone[data-zone='klima']:focus-visible .zone__feld,
  .zone[data-zone='klima'].ist-aktiv .zone__feld {
    fill: color-mix(in srgb, var(--medium-luft) 12%, transparent);
    stroke: var(--medium-luft);
  }
  .zone[data-zone='bad']:hover .zone__feld,
  .zone[data-zone='bad']:focus-visible .zone__feld,
  .zone[data-zone='bad'].ist-aktiv .zone__feld {
    fill: color-mix(in srgb, var(--medium-wasser) 12%, transparent);
    stroke: var(--medium-wasser);
  }
  .zone[data-zone='waerme']:hover .zone__feld,
  .zone[data-zone='waerme']:focus-visible .zone__feld,
  .zone[data-zone='waerme'].ist-aktiv .zone__feld {
    fill: color-mix(in srgb, var(--medium-waerme) 12%, transparent);
    stroke: var(--medium-waerme);
  }
  .zone[data-zone='kundendienst']:hover .zone__feld,
  .zone[data-zone='kundendienst']:focus-visible .zone__feld,
  .zone[data-zone='kundendienst'].ist-aktiv .zone__feld {
    fill: color-mix(in srgb, var(--medium-service) 14%, transparent);
    stroke: var(--medium-service);
  }
  .zone:hover .zone__marke,
  .zone:focus-visible .zone__marke,
  .zone.ist-aktiv .zone__marke { fill: var(--ink); }

  .zone:focus-visible { outline: none; }
  .zone:focus-visible .zone__feld { stroke-width: 2.5; }

  /* --- Legende --- */
  .schnitt__legende {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: .5rem;
  }

  .legende {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: .9rem;
    padding: .85rem .95rem;
    min-height: 3.5rem;
    background: var(--weiss);
    border: 1px solid var(--linie);
    border-left: 3px solid var(--linie-stark);
    border-radius: var(--r-2);
    text-decoration: none;
    color: var(--ink);
    transition: border-color var(--t-kurz) var(--e-aus),
                box-shadow var(--t-kurz) var(--e-aus),
                transform var(--t-kurz) var(--e-aus);
  }
  .legende[data-medium='luft']    { border-left-color: var(--medium-luft); }
  .legende[data-medium='wasser']  { border-left-color: var(--medium-wasser); }
  .legende[data-medium='waerme']  { border-left-color: var(--medium-waerme); }
  .legende[data-medium='service'] { border-left-color: var(--medium-service); }

  .legende:hover,
  .legende:focus-visible {
    box-shadow: var(--schatten-2);
    transform: translateX(3px);
    color: var(--ink);
  }
  .legende:hover .legende__pfeil { transform: translateX(3px); }

  .legende__zeichen {
    display: grid;
    place-items: center;
    width: 2.6rem; height: 2.6rem;
    border-radius: var(--r-2);
    background: var(--papier-2);
    color: var(--navy);
  }
  .legende[data-medium='luft'] .legende__zeichen    { background: var(--medium-luft-flaeche);   color: var(--medium-luft); }
  .legende[data-medium='wasser'] .legende__zeichen  { background: var(--medium-wasser-flaeche); color: var(--medium-wasser); }
  .legende[data-medium='waerme'] .legende__zeichen  { background: var(--medium-waerme-flaeche); color: var(--medium-waerme); }
  .legende[data-medium='service'] .legende__zeichen { background: var(--medium-service-flaeche); color: var(--medium-service); }

  .legende__text { display: grid; gap: .1rem; min-width: 0; }
  .legende__text strong {
    font-family: var(--f-display);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -.01em;
  }
  .legende__text .mass { font-size: .625rem; }
  .legende__text small {
    font-size: .8125rem;
    line-height: 1.4;
    color: var(--ink-2);
  }
  .legende__pfeil {
    color: var(--ink-3);
    transition: transform var(--t-kurz) var(--e-aus);
  }

  @media (prefers-reduced-motion: reduce) {
    .strang__fluss { animation: none; stroke-dasharray: 6 14; opacity: .55; }
    .legende:hover, .legende:focus-visible { transform: none; }
  }
</style>

<script>
  import { starteHausSchnitt } from '@/scripts/haus-schnitt';
  starteHausSchnitt();
</script>
