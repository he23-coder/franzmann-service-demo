---
import Basis from '@/layouts/Basis.astro';
interface Props { titel: string; beschreibung: string; ueberschrift: string; }
const { titel, beschreibung, ueberschrift } = Astro.props;
---
<Basis titel={titel} beschreibung={beschreibung}>
  <section class="rechtskopf">
    <div class="schacht">
      <p class="pos">Rechtliches</p>
      <h1>{ueberschrift}</h1>
    </div>
  </section>
  <section class="abschnitt abschnitt--eng">
    <div class="schacht"><div class="rechtstext"><slot /></div></div>
  </section>
</Basis>

<style is:global>
  .rechtskopf { border-bottom: 1px solid var(--linie); padding-block: clamp(1.75rem, 4vw, 2.5rem); }
  .rechtskopf h1 { margin-top: .9rem; font-size: clamp(2rem, 1.4rem + 2.6vw, 3rem); letter-spacing: -.03em; }

  .rechtstext { max-width: 44rem; }
  .rechtstext h2 {
    margin-top: 2.5rem;
    font-size: 1.375rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--linie);
  }
  .rechtstext h2:first-child { margin-top: 0; border-top: 0; padding-top: 0; }
  .rechtstext h3 { margin-top: 1.75rem; font-size: 1.0625rem; }
  .rechtstext p, .rechtstext ul, .rechtstext dl { margin-top: .9rem; color: var(--ink-2); font-size: .9375rem; line-height: 1.7; }
  .rechtstext ul { padding-left: 1.15rem; }
  .rechtstext li { margin-top: .35rem; }
  .rechtstext dl { display: grid; gap: .75rem; }
  .rechtstext dl > div { display: grid; grid-template-columns: 12rem minmax(0, 1fr); gap: .75rem; }
  @media (max-width: 34rem) { .rechtstext dl > div { grid-template-columns: 1fr; gap: .1rem; } }
  .rechtstext dt {
    font-family: var(--f-mono); font-size: .6875rem; letter-spacing: .08em;
    text-transform: uppercase; color: var(--ink-3); padding-top: .2rem;
  }
  .rechtstext dd { margin: 0; font-weight: 600; color: var(--ink); }
  .rechtstext address { font-style: normal; font-weight: 600; color: var(--ink); line-height: 1.6; }
</style>
